[Unit]
Description=WebModbusTerm - serial / Modbus web terminal
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/webmodbusterm
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/webmodbusterm/.venv/bin/webmodbusterm
Restart=on-failure
RestartSec=3

# Allow serial device access if not running as root:
# SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target
